font-family = "MesloLGS Nerd Font Mono"
font-family = "BIZ UDGothic"
font-size = 13
adjust-icon-height = 10

window-padding-x = 10
window-padding-y = 0,10
cursor-opacity = 0.8
background-opacity = 0.9
background-blur = 8
# fish経由で起動してPATH等の環境変数を引き継ぐ (直接起動だとherdrのPATHにhomebrewが入らず、
# file-viewerのレンダラー (bat/glow/delta) が見つからない)
initial-command = /opt/homebrew/bin/fish -l -c herdr

theme = "Zenwritten Dark"
palette = 7=#ffffff

# Keybindings for herdr
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
# cmd+` / cmd+shift+` を kitty CSI-u シーケンスで herdr に送る (ワークスペース切り替え)
# 96 = バッククォート、修飾フラグ 9 = cmd / 10 = cmd+shift
keybind = cmd+backquote=text:\x1b[96;9u
keybind = cmd+shift+backquote=text:\x1b[96;10u
# ctrl+tab / ctrl+shift+tab を kitty CSI-u シーケンスで herdr に送る (Window/タブ切り替え)
# Ghostty デフォルトのタブ切り替えを上書き。9 = Tab、修飾フラグ 5 = ctrl / 6 = ctrl+shift
keybind = ctrl+tab=text:\x1b[9;5u
keybind = ctrl+shift+tab=text:\x1b[9;6u
