# 1Password SSH Bookmarksで自動生成された鍵設定を読み込む
Include ~/.ssh/1Password/config

# OrbStackの自動生成設定は、すべてのHostブロックより前に読み込む
Include ~/.orbstack/ssh/config

# リポジトリで管理しないホスト固有・機密性のある設定
Include ~/.ssh/config.local

Host github-personal
    HostName github.com
    User git

Host github-work
    HostName github.com
    User git

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    UseKeychain yes
