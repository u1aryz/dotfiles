{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.2",
  "selfUpdateCommand": ["mise", "use", "-g", "npm:{packageName}@{version}"],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "low",
  "defaultTools": ["+codemode"],
  "codemode": {
    "mode": "only"
  },
  "packages": [
    "npm:@gotgenes/pi-permission-system",
    "npm:@narumitw/pi-plan-mode",
    "npm:pi-subagents",
    "npm:@ayulab/pi-rewind",
    "npm:@ff-labs/pi-fff",
    "npm:@pi-plugins/usage",
    "npm:pi-manage-dirs",
    "npm:pi-web-access",
    "npm:@justjoshn/pi-xai-oauth"
  ],
  "subagents": {
    "defaultModel": "anthropic/claude-opus-5-5",
    "defaultThinking": "low",
    "agentOverrides": {
      "scout": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "low"
      },
      "researcher": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "low"
      },
      "worker": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "high"
      },
      "oracle": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "high"
      },
      "delegate": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "medium"
      }
    }
  },
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 65536
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@gotgenes/pi-permission-system\",\"scope\":\"user\"}": "42.1.0",
    "{\"source\":\"npm:@narumitw/pi-plan-mode\",\"scope\":\"user\"}": "0.60.2",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.89.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:@justjoshn/pi-xai-oauth\",\"scope\":\"user\"}": "0.1.6"
  }
}
