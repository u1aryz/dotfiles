{
  "authorizerChain": ["pi-auto-review"],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.ssh/*.pub": "allow",
      "~/.ssh/config": "allow",
      "~/.ssh/known_hosts": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git add": "allow",
      "git add *": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "sudo *": "deny",
      "*/sudo *": "deny",
      "git* push --force *": "deny",
      "git* push * --force *": "deny",
      "git* push --mirror *": "deny",
      "git* push * --mirror *": "deny",
      "git* push -f* *": "deny",
      "git* push * -f* *": "deny",
      "git* push -v*f* *": "deny",
      "git* push * -v*f* *": "deny",
      "git* push -q*f* *": "deny",
      "git* push * -q*f* *": "deny",
      "git* push -u*f* *": "deny",
      "git* push * -u*f* *": "deny",
      "git* push -n*f* *": "deny",
      "git* push * -n*f* *": "deny",
      "git* push -d*f* *": "deny",
      "git* push * -d*f* *": "deny",
      "git* push -4*f* *": "deny",
      "git* push * -4*f* *": "deny",
      "git* push -6*f* *": "deny",
      "git* push * -6*f* *": "deny",
      "git* push +* *": "deny",
      "git* push * +* *": "deny",
      "*/git* push --force *": "deny",
      "*/git* push * --force *": "deny",
      "*/git* push --mirror *": "deny",
      "*/git* push * --mirror *": "deny",
      "*/git* push -f* *": "deny",
      "*/git* push * -f* *": "deny",
      "*/git* push -v*f* *": "deny",
      "*/git* push * -v*f* *": "deny",
      "*/git* push -q*f* *": "deny",
      "*/git* push * -q*f* *": "deny",
      "*/git* push -u*f* *": "deny",
      "*/git* push * -u*f* *": "deny",
      "*/git* push -n*f* *": "deny",
      "*/git* push * -n*f* *": "deny",
      "*/git* push -d*f* *": "deny",
      "*/git* push * -d*f* *": "deny",
      "*/git* push -4*f* *": "deny",
      "*/git* push * -4*f* *": "deny",
      "*/git* push -6*f* *": "deny",
      "*/git* push * -6*f* *": "deny",
      "*/git* push +* *": "deny",
      "*/git* push * +* *": "deny"
    }
  }
}
