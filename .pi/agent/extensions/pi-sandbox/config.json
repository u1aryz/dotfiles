{
  "subagents": {
    "provider": "pi-subagents",
    "protection": "native-background-tools",
    "allowedNativeAgents": [
      "scout",
      "researcher",
      "worker",
      "reviewer",
      "oracle",
      "delegate"
    ]
  },
  "filesystem": {
    "additionalAllowRead": [
      "/Users/u1aryz/.local/share/mise",
      "/Users/u1aryz/.local/state/mise",
      "/Users/u1aryz/Library/Caches/mise"
    ]
  },
  "hostIPC": {
    "mode": "ask",
    "preflightCommandPrefixes": ["playwright-cli"],
    "retryOnUnixSocketError": true
  }
}
