{
  "subagents": {
    "provider": "pi-subagents",
    "protection": "native-background-tools",
    "allowedNativeAgents": [
      "scout",
      "researcher",
      "worker",
      "reviewer",
      "oracle",
      "delegate"
    ]
  },
  "hostIPC": {
    "mode": "ask",
    "preflightCommandPrefixes": [
      "mise run format",
      "mise run lint",
      "mise run test"
    ],
    "retryOnUnixSocketError": false
  },
  "filesystem": {
    "additionalAllowRead": [
      "/Users/u1aryz/.local/share/mise/installs",
      "/Users/u1aryz/.local/share/mise/shims"
    ]
  }
}
