{
  "subagents": {
    "provider": "pi-subagents",
    "protection": "native-background-tools",
    "allowedNativeAgents": [
      "scout",
      "researcher",
      "worker",
      "reviewer",
      "oracle",
      "delegate"
    ]
  },
  "hostIPC": {
    "mode": "ask",
    "preflightCommandPrefixes": [
      "mise run format",
      "mise run lint",
      "mise run test",
      "pnpm format",
      "pnpm lint",
      "pnpm test",
      "pnpm typecheck"
    ],
    "retryOnUnixSocketError": false
  }
}
